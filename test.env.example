# Keboola Snowflake Adapter Test Configuration
# Copy this file to test.env and fill in your actual values
# IMPORTANT: test.env should be in .gitignore to keep credentials secure

# Keboola Connection Settings
KEBOOLA_BASE_URL=https://connection.keboola.com
KEBOOLA_TOKEN=your-keboola-token-here
KEBOOLA_BRANCH_ID=your-branch-id
KEBOOLA_WORKSPACE_ID=your-workspace-id

# Optional: Database name (defaults to TEST_DATABASE if not set)
KEBOOLA_DATABASE=TEST_DATABASE
